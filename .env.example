# ==============================================================================
# Collective Campus Environment Variables Example (.env.example)
# Salin berkas ini menjadi .env dan sesuaikan nilainya dengan konfigurasi lokal/server Anda.
# PENTING: Jangan menyertakan kredensial asli ke dalam repositori publik!
# ==============================================================================

# Core Django Settings
# Di lingkungan produksi sesungguhnya, DEBUG WAJIB False dan SECRET_KEY wajib acak kuat minimal 50 karakter.
DEBUG=False
SECRET_KEY=ganti-dengan-kunci-rahasia-acak-minimal-50-karakter-yang-sangat-aman-dan-unik
ALLOWED_HOSTS=127.0.0.1,localhost,collectivecampus.id,www.collectivecampus.id
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://collectivecampus.id,https://www.collectivecampus.id

# Kustomisasi URL Admin (mengaburkan path panel admin dari serangan bot)
ADMIN_URL=kelola-collective/

# Database PostgreSQL
DATABASE_URL=postgres://postgres:password_db_anda@127.0.0.1:5432/kampusrent

# Berkas Media & Penyimpanan
# SERVE_MEDIA_LOCAL=True memungkinkan Django/waitress melayani media publik (foto barang) secara lokal.
# Pada server publik sesungguhnya, berkas media disarankan dilayani oleh Nginx / Caddy / Cloudflare R2 / S3.
# Catatan: direktori private_media/ (KTM) TIDAK PERNAH dilayani publik secara langsung.
SERVE_MEDIA_LOCAL=True

# Pengaturan Keamanan & HTTPS (Aktifkan saat domain sudah memiliki SSL/HTTPS)
USE_HTTPS=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000

# Layanan Email SMTP (Aktivasi Akun, Verifikasi Email Kampus, dan Atur Ulang Kata Sandi)
# Untuk pengembangan lokal, bawaan menggunakan console backend (email tercetak di terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Contoh untuk produksi dengan SMTP Gmail / Mailgun / Amazon SES:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=layanan@collectivecampus.id
# EMAIL_HOST_PASSWORD=app_password_rahasia_anda
DEFAULT_FROM_EMAIL=Collective Campus <no-reply@collectivecampus.id>
SUPPORT_EMAIL=bantuan@collectivecampus.id

# Midtrans Payment Gateway
# Dapatkan Server Key dan Client Key dari Dashboard Midtrans (https://dashboard.midtrans.com)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=False
# Daftar metode pembayaran Snap (dipisah koma). Kosongkan untuk menampilkan semua metode aktif.
# Target utama mahasiswa: DANA (dana), SeaBank VA (seabank_va), Mandiri (echannel), QRIS (other_qris)
MIDTRANS_ENABLED_PAYMENTS=dana,seabank_va,echannel,other_qris
# Mode tampilan Snap: popup (bawaan) atau embed
MIDTRANS_SNAP_MODE=popup

# Handover WhatsApp Setting
# Menampilkan tombol & nomor WhatsApp lawan bicara di halaman detail sewa pada jendela serah terima
WHATSAPP_HANDOVER_ENABLED=True

# OCR Kartu Tanda Mahasiswa (Tesseract)
# Di Windows arahkan ke path biner tesseract.exe jika tidak ada di PATH sistem.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
KTM_AUTO_APPROVE=False
KTM_DELETE_AFTER_DECISION=True

# Parameter Aturan Bisnis & Dana Gotong Royong
PLATFORM_COMMISSION_PERCENT=8
PROTECTION_FEE=3000
LATE_FEE_PERCENT_PER_DAY=50
APPROVAL_DEADLINE_HOURS=24
PAYMENT_DEADLINE_HOURS=6
AUTO_CONFIRM_RETURN_HOURS=48

# SPEC v2 Tangga Kepercayaan & Mitigasi Risiko
TRUST_TIERS=baru:750000:15,tepercaya:1500000:10,sangat_tepercaya:3000000:10
MAX_ITEM_VALUE=3000000
NO_DEPOSIT_BELOW_VALUE=150000
MIN_DEPOSIT_AMOUNT=25000
CROSS_CAMPUS_EXTRA_DEPOSIT_PERCENT=5
PROTECTION_FEE_PERCENT=5
PROTECTION_FEE_MIN=3000
PROTECTION_MANDATORY_ABOVE=500000
HANDOVER_PHOTO_RETENTION_DAYS=30
NON_RETURN_GRACE_HOURS=48

# ==============================================================================
# Fase 7C: Saldo Dompet, Penarikan Dana & Retraining Model ML
# ==============================================================================
# Kunci enkripsi Fernet untuk data sensitif (mis. nomor rekening penarikan dana)
# Wajib berupa 32 url-safe base64-encoded bytes.
# Cara menghasilkan kunci baru:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=bWk5ZmljRDBkY3h6M1Z2Uld5b3BLblV3M3kyRUR4MGh1YThwOG5VWTJtOD0=

# Batas minimal penarikan dana dompet mahasiswa (Rp)
WITHDRAWAL_MIN=20000

# Ambang batas data nyata untuk pemicu pelatihan ulang model ML (retrain_trust_model)
TRUST_MIN_REAL_EXAMPLES=200
TRUST_MIN_POSITIVES=20

# ==============================================================================
# Fase 10: Pengaturan Merek & Identitas Platform (Collective Campus)
# ==============================================================================
SITE_NAME=Collective Campus
SITE_SHORT_NAME=Collective
SITE_TAGLINE=Saling sewa, saling jual, saling bantu.
SITE_DOMAIN=
SITE_LOGOTYPE_DARK=Collective
SITE_LOGOTYPE_ACCENT=Campus


